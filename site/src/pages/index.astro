---
// Static page, client-side pipeline. The only reason this is Astro rather than a lone HTML file
// is that the pipeline imports lib/core.mjs and three WASM packages, and something has to
// resolve and bundle them.
const outputs = [
  ['logo.svg', 'The mark itself. Optimised, animation intact. For pages and READMEs.'],
  ['icon.svg', 'The same optimisation plus a structural animation strip. The browser favicon, and what every raster below is rendered from.'],
  ['favicon.ico', 'One 32x32 entry, a raw PNG in a 22-byte container.'],
  ['apple-touch-icon.png', '180x180 on the chosen ground, the mark placed in the safe zone.'],
  ['icon-192.png, icon-512.png', 'On the same ground, placed the same way. The manifest\'s "any maskable" icons.'],
  ['site.webmanifest', 'Icons only - merge your own name and theme_color.'],
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>favcon — one SVG in, an optimised favicon set out</title>
<meta name="description" content="Generate a complete favicon set from one SVG, entirely in your browser. Nothing is uploaded." />
<link rel="stylesheet" href="/styles/app.css" />
</head>
<body>
<header class="band">
  <h1>favcon</h1>
  <p class="lede">One SVG in, an optimised favicon set out.</p>
  <p class="quiet">
    Everything below runs in this tab. There is no upload endpoint, because there is no server
    to receive one — the page is static files.
  </p>
</header>

<main>
  <section class="card">
    <div id="drop" class="drop" tabindex="0" role="button" aria-describedby="drop-help">
      <input type="file" id="file" accept=".svg,image/svg+xml" hidden />
      <strong>Choose an SVG</strong>
      <span id="drop-help" class="quiet">or drop one here</span>
    </div>

    <div class="options">
      <label>Palette
        <input type="number" id="colors" value="8" min="2" max="256" />
        <span class="quiet">2–256. Raise it for a mark with gradients.</span>
      </label>
      <label>Sizes
        <input type="text" id="sizes" value="192 512" />
        <span class="quiet">The padded “any maskable” icons.</span>
      </label>
      <label>Ground
        <input type="text" id="bg" value="#000000" />
        <span class="quiet">Under the padded icons. <code>none</code> keeps alpha and declares them <code>any</code> only.</span>
      </label>
      <label>Padding
        <input type="text" id="padding" value="auto" />
        <span class="quiet">Percent per side, or <code>auto</code> to measure the mark.</span>
      </label>
      <label class="check">
        <input type="checkbox" id="animation" checked />
        Keep the animation in <code>logo.svg</code>
      </label>
    </div>

    <button id="go" disabled>Generate</button>
    <p id="status" class="status" role="status" aria-live="polite"></p>
  </section>

  <section id="result" class="card" hidden>
    <div class="previews">
      <figure><div class="swatch light"><img id="p-light" alt="the mark on white" /></div><figcaption>on white</figcaption></figure>
      <figure><div class="swatch dark"><img id="p-dark" alt="the mark on dark" /></div><figcaption>on dark</figcaption></figure>
      <figure><div class="swatch"><img id="p-mask" class="masked" alt="a padded icon under a circular mask" /></div><figcaption>masked</figcaption></figure>
    </div>
    <table id="sizes-table"><thead><tr><th>file</th><th>bytes</th><th></th></tr></thead><tbody></tbody></table>
    <p id="fit" class="quiet"></p>
    <button id="download">Download .zip</button>
    <h2>Add to your <code>&lt;head&gt;</code></h2>
    <pre id="links"></pre>
  </section>

  <section class="card">
    <h2>What you get</h2>
    <dl class="outputs">
      {outputs.map(([name, what]) => (<><dt><code>{name}</code></dt><dd>{what}</dd></>))}
    </dl>
  </section>

  <section class="card warn">
    <h2>These bytes are not the CLI's bytes</h2>
    <p>
      <strong>The SVGs are exact.</strong> This page runs the same svgo plugin list as the
      command line tool, imported from the same file, so <code>logo.svg</code>,
      <code>icon.svg</code> and <code>site.webmanifest</code> come out byte-identical. The mark
      is placed in the masked icons by the same fit-and-snap search, so it lands on the same
      pixel. <code>favicon.ico</code>'s 22-byte container is the same code too — but its payload
      is a PNG, so the file differs by whatever the PNG differs by.
    </p>
    <p>
      <strong>The PNGs are larger</strong>, because the three programs the CLI shells out to have
      no browser equivalents, only substitutes:
    </p>
    <table class="compare">
      <thead><tr><th>stage</th><th>command line</th><th>this page</th></tr></thead>
      <tbody>
        <tr><td>render</td><td>resvg 0.48.1</td><td><code>@resvg/resvg-wasm</code> 2.6.2</td></tr>
        <tr><td>quantise</td><td>pngquant (libimagequant)</td><td><code>image-q</code> — a different algorithm</td></tr>
        <tr><td>recompress</td><td>oxipng <code>-o max --zopfli --zi 120</code></td><td><code>@jsquash/oxipng</code> level 6 — <strong>no zopfli</strong></td></tr>
      </tbody>
    </table>
    <p>Measured over four fixtures, PNG bytes only:</p>
    <table class="compare">
      <thead><tr><th>mark</th><th>CLI</th><th>here</th><th></th></tr></thead>
      <tbody>
        <tr><td>flat, pixel grid</td><td>600 B</td><td>620 B</td><td>+3.3%</td></tr>
        <tr><td>dense geometry</td><td>3574 B</td><td>3758 B</td><td>+5.1%</td></tr>
        <tr><td>two-colour mark</td><td>3525 B</td><td>3758 B</td><td>+6.6%</td></tr>
        <tr><td><strong>radial gradient</strong></td><td>5228 B</td><td>10730 B</td><td><strong>+105%</strong></td></tr>
      </tbody>
    </table>
    <p>
      A flat mark costs a few percent. <strong>A mark with smooth colour ramps more than
      doubles</strong> — that is the quantiser difference and the missing zopfli together, and
      it is why this page will not tell you what your icons will weigh.
    </p>
    <p>
      Treat this as a preview you can see and click. For bytes you can measure, reproduce and
      diff into git, run <code>npx favcon logo.svg</code>.
    </p>
  </section>
</main>

<footer class="quiet">
  MIT. <a href="https://github.com/favcon/favcon">Source</a> ·
  favcon also ships a CLI and an Astro integration.
</footer>

<script>
  import { buildInBrowser } from '../lib/pipeline.mjs';

  const el = (id) => document.getElementById(id);
  const drop = el('drop'), file = el('file'), go = el('go'), status = el('status');
  const result = el('result'), tbody = el('sizes-table').querySelector('tbody');
  let svgText = null, built = null, urls = [];

  const say = (msg, kind = '') => { status.textContent = msg; status.className = `status ${kind}`; };

  const accept = async (f) => {
    if (!f) return;
    if (!/\.svg$/i.test(f.name) && f.type !== 'image/svg+xml') return say('That is not an SVG.', 'bad');
    svgText = await f.text();
    drop.querySelector('strong').textContent = f.name;
    go.disabled = false;
    say('Ready.');
  };

  drop.addEventListener('click', () => file.click());
  drop.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); file.click(); } });
  file.addEventListener('change', () => accept(file.files[0]));
  for (const type of ['dragenter', 'dragover']) {
    drop.addEventListener(type, (e) => { e.preventDefault(); drop.classList.add('over'); });
  }
  for (const type of ['dragleave', 'drop']) {
    drop.addEventListener(type, () => drop.classList.remove('over'));
  }
  drop.addEventListener('drop', (e) => { e.preventDefault(); accept(e.dataTransfer.files[0]); });

  el('go').addEventListener('click', async () => {
    if (!svgText) return;
    go.disabled = true;
    say('Loading the WASM codecs…');
    for (const u of urls) URL.revokeObjectURL(u);
    urls = [];
    try {
      const t0 = performance.now();
      built = await buildInBrowser(svgText, {
        colors: el('colors').value,
        sizes: el('sizes').value.trim().split(/[\s,]+/).filter(Boolean).map(Number),
        bg: el('bg').value.trim(),
        padding: el('padding').value.trim() === 'auto' ? 'auto' : Number(el('padding').value),
        animation: el('animation').checked,
      });
      const ms = Math.round(performance.now() - t0);

      tbody.replaceChildren();
      const url = (bytes, type) => {
        const u = URL.createObjectURL(new Blob([bytes], { type }));
        urls.push(u);
        return u;
      };
      for (const f of built.files) {
        const isSvg = f.name.endsWith('.svg');
        const href = url(f.bytes, isSvg ? 'image/svg+xml' : f.name.endsWith('.ico') ? 'image/x-icon' : f.name.endsWith('.webmanifest') ? 'application/manifest+json' : 'image/png');
        const tr = document.createElement('tr');
        const name = document.createElement('td'); name.innerHTML = `<code>${f.name}</code>`;
        const size = document.createElement('td'); size.textContent = `${f.bytes.length} B`;
        const link = document.createElement('td');
        const a = document.createElement('a'); a.href = href; a.download = f.name; a.textContent = 'save';
        link.append(a);
        tr.append(name, size, link);
        tbody.append(tr);
      }

      const byName = Object.fromEntries(built.files.map((f) => [f.name, f]));
      const icon = byName['icon.svg'];
      const iconUrl = url(icon.bytes, 'image/svg+xml');
      el('p-light').src = iconUrl;
      el('p-dark').src = iconUrl;
      const f = built.fit;
      const biggest = Object.keys(f.icons).map(Number).sort((a, b) => b - a)[0];
      const show = f.icons[biggest];
      // The masked preview shows the largest padded icon: that is what a launcher masks.
      el('p-mask').src = show ? url(byName[`icon-${biggest}.png`].bytes, 'image/png') : iconUrl;
      el('fit').textContent = show
        ? `Mark placed at ${show.box}px of ${show.canvas} in the safe zone` +
          `${show.snapped ? ', snapped to whole pixels' : ''}` +
          `${show.fullBleed ? ' (full-bleed source, used as drawn)' : ''}.`
        : 'No padded icon: the ground is transparent.';
      el('links').textContent = built.links.trim();
      result.hidden = false;
      say(`Done in ${ms} ms. ${built.animated ? 'logo.svg keeps its animation.' : 'The source is static.'}`, 'good');
    } catch (e) {
      say(e?.message ?? String(e), 'bad');
    } finally {
      go.disabled = false;
    }
  });

  el('download').addEventListener('click', () => {
    if (!built) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([built.archive()], { type: 'application/zip' }));
    a.download = 'favcon.zip';
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
</body>
</html>
