{
  "name": "favcon",
  "version": "0.1.0",
  "description": "One SVG in, an optimised favicon set out.",
  "type": "module",
  "license": "MIT",
  "author": "Cevdet",
  "bin": { "favcon": "bin/favcon.mjs" },
  "exports": {
    ".": "./bin/favcon.mjs",
    "./core": "./lib/core.mjs",
    "./astro": "./astro/index.mjs",
    "./astro/middleware": "./astro/middleware.mjs",
    "./astro/Head.astro": "./astro/Head.astro",
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=22.12" },
  "files": ["bin", "lib", "astro", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "test": "node --test test/run.mjs",
    "bench": "node bench/bench.mjs"
  },
  "dependencies": {
    "svgo": "^4.1.0"
  },
  "optionalDependencies": {
    "pngquant-bin": "^9.0.0"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true }
  },
  "keywords": [
    "favicon", "favicons", "icon", "svg", "astro-integration", "astro", "pwa",
    "apple-touch-icon", "webmanifest", "ico", "png", "optimisation", "cli"
  ],
  "repository": { "type": "git", "url": "git+https://github.com/favcon/favcon.git" },
  "bugs": { "url": "https://github.com/favcon/favcon/issues" },
  "homepage": "https://github.com/favcon/favcon#readme",
  "publishConfig": { "access": "public", "provenance": true }
}
